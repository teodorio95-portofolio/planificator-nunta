# Copiați fișierul în .env și completați. Repornirea containerului aplică schimbările.

# --- Intrarea cu parolă (cea mai simplă) ---
# O parolă comună pe rol, minim 8 caractere. Admin: tot, inclusiv Setări, backup și Notițe.
# Editor: planifică și modifică. Reader: doar se uită (poate adăuga sarcini).
# Lăsați goale rolurile de care nu aveți nevoie. O parolă schimbată deconectează pe toți cei care o foloseau.
ADMIN_PASSWORD=
EDITOR_PASSWORD=
READER_PASSWORD=

# --- Intrarea cu Google (opțională, în loc de parole sau pe lângă ele) ---
# Client OAuth de tip „Web application” din Google Cloud, cu redirect URI <adresa>/auth/google/callback.
# Merge doar pe HTTPS (compose.https.yaml) sau în `make dev`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cine poate intra cu Google, separați prin virgulă.
ADMIN_EMAILS=
EDITOR_EMAILS=
READER_EMAILS=

# --- HTTPS cu Caddy (compose.https.yaml) ---
# Domeniul vostru, de ex. nunta.exemplu.ro
DOMAIN=
# Cu Caddy în față, portul aplicației rămâne doar pe server (`make up-https` îl setează singur).
# BIND_ADDRESS=127.0.0.1

# --- Altele ---
# O nuntă inventată, ca să încercați aplicația pe o bază goală.
DEMO_DATA=false
# Fără nicio parolă și fără Google aplicația rămâne blocată. `true` o deschide oricui, ca admin:
# doar pe calculatorul vostru, niciodată pe un server accesibil din internet.
AUTH_DISABLED=false
